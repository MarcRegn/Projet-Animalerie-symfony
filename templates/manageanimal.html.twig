{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Gestion des animaux{% endblock %}

{% block body %}

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">

            <h1 class="h2 font-weight-bold mb-0">
                Gestion des animaux
            </h1>

            <a href="{{ path('create-animal') }}"
               class="btn btn-primary rounded-pill px-4">
                + Ajouter un animal
            </a>

        </div>

        <div class="card border-0 shadow-sm">
            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="thead-light">
                    <tr>
                        <th>Nom</th>
                        <th>Âge</th>
                        <th>Statut</th>
                        <th class="text-right">Actions</th>
                    </tr>
                    </thead>

                    <tbody>

                    {% for animal in animals %}

                        <tr>
                            <td class="font-weight-bold align-middle">
                                {{ animal.name }}
                            </td>

                            <td class="align-middle">
                                {{ animal.age }}
                                {{ animal.age > 1 ? 'ans' : 'an' }}
                            </td>

                            <td class="align-middle">
                                {% if animal.status.value == 'available' %}
                                    <span class="badge badge-success">Disponible</span>
                                {% elseif animal.status.value == 'adoption_pending' %}
                                    <span class="badge badge-warning">Adoption en cours</span>
                                {% else %}
                                    <span class="badge badge-secondary">Adopté</span>
                                {% endif %}
                            </td>

                            <td class="text-right align-middle">
                                <a href="{{ path('edit-animal', {id: animal.id}) }}"
                                   class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    Modifier
                                </a>
                            </td>
                        </tr>

                    {% else %}

                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                Aucun animal pour le moment.
                            </td>
                        </tr>

                    {% endfor %}

                    </tbody>

                </table>

            </div>
        </div>

    </div>

{% endblock %}
