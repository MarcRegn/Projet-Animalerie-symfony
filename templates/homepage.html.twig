{% extends 'base.html.twig' %}

{% block title %}
    {{ parent() }} | Accueil
{% endblock %}

{% block body %}

    <style>

        body {
            font-family: 'Nunito', sans-serif;
            background: #f8fafc;
        }

        .hero {
            min-height: 560px;
            background: linear-gradient(
                135deg,
                #e8f4ff 0%,
                #f4fbff 50%,
                #ffffff 100%
            );
            display: flex;
            align-items: center;
        }

        .hero-title {
            font-size: 3.8rem;
            font-weight: 800;
            line-height: 1.1;
        }

        .hero-title span {
            color: #007bff;
        }

        .hero-text {
            font-size: 1.2rem;
            color: #64748b;
            line-height: 1.8;
        }

        .animal-card {
            border: none;
            border-radius: 20px;
            overflow: hidden;
            transition: all .25s ease;
        }

        .animal-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 15px 35px rgba(0,0,0,.10);
        }

        .feature-card {
            border: none;
            border-radius: 20px;
            background: white;
            padding: 35px;
            height: 100%;
            box-shadow: 0 5px 25px rgba(0,0,0,.05);
        }

        .feature-icon {
            width: 65px;
            height: 65px;
            border-radius: 18px;
            background: #e8f4ff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            margin-bottom: 20px;
        }

        .cta {
            border-radius: 25px;
            background: linear-gradient(
                135deg,
                #007bff,
                #0056b3
            );
            color: white;
            padding: 70px 30px;
        }

    </style>


    {# HERO #}

    <section class="hero">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-lg-6 mb-5 mb-lg-0">

                <span class="badge badge-primary px-3 py-2 mb-4">
                    🐾 REFUGE ANIMALIER
                </span>

                    <h1 class="hero-title mb-4">

                        Une nouvelle vie
                        <span>commence ici.</span>

                    </h1>

                    <p class="hero-text mb-4">

                        Découvrez les animaux accueillis dans notre refuge
                        et trouvez celui qui partagera bientôt votre quotidien.

                        Chaque adoption est une nouvelle histoire qui commence.

                    </p>

                    <div>

                        <a href="{{ path('list-animal') }}"
                           class="btn btn-primary btn-lg rounded-pill px-5 mr-2">

                            Découvrir nos animaux →

                        </a>

                    </div>

                </div>


                <div class="col-lg-6 text-center">

                    <div style="font-size: 190px;">
                        🐶
                    </div>

                    <div class="mt-3">

                    <span class="badge badge-light px-4 py-2 shadow-sm">
                        ❤️ Une famille pour chaque animal
                    </span>

                    </div>

                </div>

            </div>

        </div>

    </section>


    {# PRESENTATION #}

    <section class="py-5">

        <div class="container">

            <div class="text-center mb-5">

            <span class="text-primary font-weight-bold">
                NOTRE MISSION
            </span>

                <h2 class="font-weight-bold mt-2">
                    Bien plus qu'un refuge
                </h2>

                <p class="text-muted mx-auto"
                   style="max-width: 650px;">

                    Notre objectif est d'offrir à chaque animal
                    un environnement sécurisé en attendant
                    de lui trouver une famille aimante.

                </p>

            </div>


            <div class="row">

                <div class="col-md-4 mb-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                            🏠
                        </div>

                        <h4 class="font-weight-bold">
                            Accueillir
                        </h4>

                        <p class="text-muted mb-0">

                            Nous accueillons les animaux ayant besoin
                            d'un environnement sécurisé et adapté.

                        </p>

                    </div>

                </div>


                <div class="col-md-4 mb-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                            ❤️
                        </div>

                        <h4 class="font-weight-bold">
                            Protéger
                        </h4>

                        <p class="text-muted mb-0">

                            Chaque animal bénéficie de soins,
                            d'attention et d'un suivi adapté.

                        </p>

                    </div>

                </div>


                <div class="col-md-4 mb-4">

                    <div class="feature-card">

                        <div class="feature-icon">
                            🏡
                        </div>

                        <h4 class="font-weight-bold">
                            Faire adopter
                        </h4>

                        <p class="text-muted mb-0">

                            Nous accompagnons les futurs adoptants
                            afin de trouver la meilleure famille possible.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    {# APPEL À L'ADOPTION #}

    <section class="py-5">

        <div class="container">

            <div class="cta text-center">

                <div style="font-size: 60px;">
                    🐾
                </div>

                <h2 class="font-weight-bold mt-3">
                    Et si votre futur compagnon vous attendait ?
                </h2>

                <p class="lead mt-3 mb-4">

                    Parcourez les animaux actuellement disponibles
                    et découvrez leur histoire.

                </p>

                <a href="{{ path('list-animal') }}"
                   class="btn btn-light btn-lg rounded-pill px-5">

                    Voir les animaux

                </a>

            </div>

        </div>

    </section>

{% endblock %}
