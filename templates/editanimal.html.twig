{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-5 mb-5">

        <h1>Modifier {{ animal.name }}</h1>

        {{ form_start(form) }}

        {{ form_errors(form) }}

        {{ form_row(form.name) }}
        {{ form_row(form.description) }}
        {{ form_row(form.age) }}
        {{ form_row(form.status) }}
        <button type="submit" class="btn btn-primary mt-3">
            Enregistrer les modifications
        </button>

        {{ form_end(form) }}

    </div>
{% endblock %}
