<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Refuge Animalier{% endblock %}</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
          rel="stylesheet">

    {% block stylesheets %}
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}
            {{ importmap('app') }}
        {% endblock %}
    {% endblock %}
</head>

<body>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-3">

    <div class="container">

        <a class="navbar-brand font-weight-bold d-flex align-items-center"
           href="{{ path('homepage') }}">

            <span style="font-size: 30px;" class="mr-2">
                🐾
            </span>

            <span>
                Refuge<span class="text-primary">Solidaire</span>
            </span>

        </a>

        <button class="navbar-toggler"
                type="button"
                data-toggle="collapse"
                data-target="#navbarContent">

            <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="navbarContent">

            <ul class="navbar-nav ml-auto align-items-lg-center">

                {# Accueil #}
                <li class="nav-item">
                    <a class="nav-link font-weight-bold"
                       href="{{ path('homepage') }}">
                        Accueil
                    </a>
                </li>

                {# Animaux #}
                <li class="nav-item">
                    <a class="nav-link font-weight-bold"
                       href="{{ path('list-animal') }}">
                        Nos animaux
                    </a>
                </li>

                {# Membre du refuge #}
                {% if is_granted('ROLE_MEMBER') %}

                    <li class="nav-item">
                        <a class="nav-link font-weight-bold"
                           href="{{ path('manage-animal') }}">
                            Gestion
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link font-weight-bold"
                           href="{{ path('create-animal') }}">
                            Ajouter un animal
                        </a>
                    </li>

                {% endif %}

                {# Administrateur #}
                {% if is_granted('ROLE_ADMIN') %}

                    <li class="nav-item">
                        <a class="nav-link font-weight-bold"
                           href="#">
                            Administration
                        </a>
                    </li>

                {% endif %}

                {# Connexion / Déconnexion #}
                {% if app.user %}

                    <li class="nav-item ml-lg-3">
                        <span class="nav-link text-muted">
                            👤 {{ app.user.email }}
                        </span>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('logout') }}"
                           class="btn btn-outline-primary rounded-pill px-4">
                            Déconnexion
                        </a>
                    </li>

                {% else %}

                    <li class="nav-item ml-lg-3">
                        <a href="{{ path('app_login') }}"
                           class="btn btn-primary rounded-pill px-4">
                            Connexion
                        </a>
                    </li>

                {% endif %}

            </ul>

        </div>

    </div>

</nav>


{# Messages flash #}

{% for message in app.flashes('success') %}

    <div class="container mt-4">

        <div class="alert alert-success alert-dismissible fade show">

            {{ message }}

            <button type="button"
                    class="close"
                    data-dismiss="alert">

                <span>&times;</span>

            </button>

        </div>

    </div>

{% endfor %}


{% for message in app.flashes('error') %}

    <div class="container mt-4">

        <div class="alert alert-danger alert-dismissible fade show">

            {{ message }}

            <button type="button"
                    class="close"
                    data-dismiss="alert">

                <span>&times;</span>

            </button>

        </div>

    </div>

{% endfor %}


{# Contenu de la page #}

{% block body %}
{% endblock %}


{# Footer #}

<footer class="bg-dark text-white mt-5 py-5">

    <div class="container">

        <div class="row">

            <div class="col-md-6">

                <h5 class="font-weight-bold">
                    🐾 Refuge Solidaire
                </h5>

                <p class="text-muted">
                    Chaque animal mérite une famille,
                    de l'amour et une seconde chance.
                </p>

            </div>

            <div class="col-md-3">

                <h6 class="font-weight-bold">
                    Navigation
                </h6>

                <a href="{{ path('homepage') }}"
                   class="d-block text-white-50 mb-2">
                    Accueil
                </a>

                <a href="{{ path('list-animal') }}"
                   class="d-block text-white-50">
                    Nos animaux
                </a>

            </div>

            <div class="col-md-3">

                <h6 class="font-weight-bold">
                    Le refuge
                </h6>

                <p class="text-white-50 mb-1">
                    📍 France
                </p>

                <p class="text-white-50">
                    ❤️ Association à but non lucratif
                </p>

            </div>

        </div>

        <hr class="border-secondary">

        <p class="text-center text-white-50 mb-0">
            © {{ "now"|date("Y") }} Refuge Solidaire
        </p>

    </div>

</footer>


<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
